# Salin file ini menjadi .env, lalu ganti semua nilai CHANGE_ME/placeholder.
# WAHA API key dipakai oleh Python controller untuk memanggil WAHA.
WAHA_API_KEY=""
WAHA_DASHBOARD_USERNAME=""
WAHA_DASHBOARD_PASSWORD=""
WHATSAPP_SWAGGER_USERNAME=""
WHATSAPP_SWAGGER_PASSWORD=""
WAHA_WEBHOOK_SECRET=""
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=waha

# Ganti dengan IP lokal ESP32 yang tercetak di Serial Monitor setelah Wi-Fi connect.
ESP32_BASE_URL=http://192.168.1.17
# Harus sama persis dengan localApiKey pada smartaquarium_waha.ino
ESP32_API_KEY=""

# Nomor WhatsApp yang diizinkan mengontrol perangkat, tanpa +, tanpa spasi,
# gunakan format Indonesia 62..., beberapa nomor dipisahkan koma.
ALLOWED_SENDERS=""
ALLOWED_LIDS=""@lid